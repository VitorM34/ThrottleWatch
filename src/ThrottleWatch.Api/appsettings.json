{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=throttlewatch;Username=postgres;Password=postgres"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "https://localhost:5001",
      "http://localhost:5173",
      "http://localhost:5100"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/throttlewatch-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "OpenTelemetry": {
    "ServiceName": "ThrottleWatch.Api",
    "OtlpEndpoint": ""
  },
  "ThrottleWatch": {
    "Alerts": {
      "Enabled": true,
      "Webhook": {
        "Enabled": false,
        "Url": "",
        "Secret": ""
      },
      "Slack": {
        "Enabled": false,
        "WebhookUrl": ""
      },
      "Discord": {
        "Enabled": false,
        "WebhookUrl": ""
      },
      "Email": {
        "Enabled": false,
        "SmtpHost": "",
        "SmtpPort": 587,
        "Username": "",
        "Password": "",
        "From": "throttlewatch@noreply.com",
        "To": [],
        "UseSsl": true
      }
    }
  },
  "AllowedHosts": "*"
