@using ApexCharts

@* Donut chart showing the breakdown of allowed vs blocked requests *@

<div class="chart-wrapper" aria-label="@L["Overview_AllowedVsBlocked"]" role="img">
    @if (IsLoading)
    {
        <div class="skeleton" style="height: 220px; border-radius: 50%; width: 220px; margin: 0 auto;"></div>
    }
    else if (Total == 0)
    {
        <EmptyState Icon="percent" Title="@L["Common_EmptyDefault"]" Message="@L["Overview_AllowedVsBlocked"]" />
    }
    else
    {
        @* Stable @key: remount only empty↔data. Remounting on every poll restarts Apex animation. *@
        <ApexChart TItem="DonutSlice"
                   Options="_options"
                   @key="_chartKey">
            <ApexPointSeries TItem="DonutSlice"
                             Items="_slices"
                             SeriesType="SeriesType.Donut"
                             Name="@L["Overview_TotalRequests"]"
                             XValue="@(s => s.Label)"
                             YValue="@(s => (decimal)s.Value)" />
        </ApexChart>
    }
</div>

@code {
    [Parameter] public long Allowed { get; set; }
    [Parameter] public long Blocked { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private ApexChartOptions<DonutSlice> _options = null!;
    private List<DonutSlice> _slices = [];
    private string _chartKey = "empty";
    private bool _hasChart;

    private long Total => Allowed + Blocked;

    protected override void OnParametersSet()
    {
        _options = BuildOptions();

        _slices =
        [
            new(L["Overview_Allowed"], Allowed),
            new(L["Overview_Blocked"], Blocked)
        ];

        var shouldShow = !IsLoading && Total > 0;
        if (shouldShow && !_hasChart)
        {
            _chartKey = "donut";
            _hasChart = true;
        }
        else if (!shouldShow && _hasChart)
        {
            _chartKey = "empty";
            _hasChart = false;
        }
    }

    private ApexChartOptions<DonutSlice> BuildOptions() => new()
    {
        Chart = new Chart
        {
            Background = "transparent",
            ForeColor = "#9aa3b8",
            Toolbar = new Toolbar { Show = false },
            Animations = new Animations
            {
                Enabled = false
            }
        },
        Colors = ["#22c55e", "#ef4444"],
        PlotOptions = new PlotOptions
        {
            Pie = new PlotOptionsPie
            {
                Donut = new PlotOptionsDonut
                {
                    Size = "65%",
                    Labels = new DonutLabels
                    {
                        Show = true,
                        Total = new DonutLabelTotal
                        {
                            Show = true,
                            Label = L["Alerts_MetricTotal"],
                            Color = "#9aa3b8",
                            FontSize = "13px"
                        },
                        Value = new DonutLabelValue
                        {
                            Color = "#f0f2f8",
                            FontSize = "20px",
                            FontWeight = "700"
                        }
                    }
                }
            }
        },
        Legend = new Legend
        {
            Position = LegendPosition.Bottom,
            Labels = new LegendLabels { Colors = "#9aa3b8" }
        },
        Tooltip = new Tooltip { Theme = Mode.Dark },
        DataLabels = new DataLabels { Enabled = false }
    };

    private sealed record DonutSlice(string Label, long Value);
}
