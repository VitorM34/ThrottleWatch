@inherits LayoutComponentBase
@inject IThemeService ThemeService
@inject IJSRuntime Js
@inject NavigationManager Navigation
@implements IDisposable

<div class="@ThemeClass theme-root">
    <div class="app-shell">
        <Sidebar OnCollapsedChanged="OnSidebarCollapsedChanged" />

        <div class="app-content @(_sidebarCollapsed ? "app-content--collapsed" : null)">
            <Topbar PageTitle="@PageTitle" SidebarCollapsed="_sidebarCollapsed" />

            <main class="app-main" id="main-content" role="main" aria-label="@L["Layout_MainContentAria"]">
                @Body
            </main>
        </div>
    </div>

    <ToastHost />
</div>

@code {
    private bool _sidebarCollapsed;
    private bool _themeInitialized;

    private string ThemeClass => ThemeService.IsDarkMode ? "dark" : "light";

    private string? PageTitle
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimStart('/').ToLowerInvariant();
            return path switch
            {
                "" => L["Nav_Overview"].Value,
                "endpoints" => L["Nav_Endpoints"].Value,
                "clients" => L["Nav_Clients"].Value,
                "policies" => L["Nav_Policies"].Value,
                "alerts" => L["Nav_Alerts"].Value,
                "history" => L["Nav_History"].Value,
                "insights" => L["Nav_Insights"].Value,
                "settings" => L["Nav_Settings"].Value,
                "about" => L["Nav_About"].Value,
                "health" => L["Nav_Health"].Value,
                _ => null
            };
        }
    }

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeInitialized)
            return;

        _themeInitialized = true;

        try
        {
            var stored = await Js.InvokeAsync<string?>("twTheme.get");
            var isDark = !string.Equals(stored, "light", StringComparison.OrdinalIgnoreCase);
            ThemeService.SetDarkMode(isDark);
        }
        catch (JSException)
        {
            // theme.js not ready; keep default.
        }
        catch (InvalidOperationException)
        {
            // JS runtime unavailable during early circuit lifecycle.
        }
    }

    private void OnSidebarCollapsedChanged(bool collapsed) => _sidebarCollapsed = collapsed;

    private void OnThemeChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeService.ThemeChanged -= OnThemeChanged;
}
