@page "/history"
@inject IMetricsService MetricsService
@implements IDisposable

<PageTitle>@L["History_PageTitle"]</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["History_Title"]</h1>
        <p class="page-subtitle">@L["History_Subtitle"]</p>
    </div>
    <div class="page-actions">
        <select class="form-control" style="width: 180px;" @bind="_window" @bind:after="LoadDataAsync" aria-label="@L["History_SelectWindow"]">
            <option value="30">@L["History_Last30Min"]</option>
            <option value="60">@L["History_Last1Hour"]</option>
            <option value="180">@L["History_Last3Hours"]</option>
            <option value="360">@L["History_Last6Hours"]</option>
            <option value="1440">@L["History_Last24Hours"]</option>
            <option value="10080">@L["History_Last7Days"]</option>
            <option value="43200">@L["History_Last30Days"]</option>
        </select>
        <button class="btn btn--secondary btn--sm" @onclick="LoadDataAsync" disabled="@_isLoading">@L["Common_Refresh"]</button>
    </div>
</div>

@if (_hasError)
{
    <ErrorState Title="@L["History_ErrorLoad"]" OnRetry="LoadDataAsync" />
}
else
{
    <ContentCard Title="@L["History_RequestVolume"]" Subtitle="@GetChartSubtitle()">
        <RequestsLineChart SeriesData="_timeSeries" IsLoading="_isLoading" />
    </ContentCard>

    <div style="margin-top: 24px;">
        <ContentCard Title="@L["History_TopEndpointsPeriod"]" Subtitle="@L["History_ByTotalRequests"]">
            <TopEndpointsBarChart Endpoints="_endpoints" IsLoading="_isLoading" />
        </ContentCard>
    </div>
}

@code {
    private IReadOnlyList<TimeSeriesData> _timeSeries = [];
    private IReadOnlyList<EndpointMetrics> _endpoints = [];
    private int _window = 60;
    private bool _isLoading = true;
    private bool _hasError;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _hasError = false;
        StateHasChanged();
        try
        {
            var tsTask = MetricsService.GetRequestTimeSeriesAsync(TimeSpan.FromMinutes(_window), _cts.Token);
            var epTask = MetricsService.GetTopEndpointsAsync(10, _cts.Token);
            await Task.WhenAll(tsTask, epTask);
            _timeSeries = tsTask.Result;
            _endpoints = epTask.Result;
        }
        catch (OperationCanceledException) { }
        catch { _hasError = true; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private string GetWindowLabel() => _window switch
    {
        30 => L["History_Window30Min"],
        60 => L["History_Window1Hour"],
        180 => L["History_Window3Hours"],
        360 => L["History_Window6Hours"],
        1440 => L["History_Window24Hours"],
        10080 => L["History_Window7Days"],
        43200 => L["History_Window30Days"],
        _ => string.Format(L["History_WindowMinutes"].Value, _window)
    };

    private string GetChartSubtitle()
    {
        var window = string.Format(L["History_LastPrefix"].Value, GetWindowLabel());
        var resolution = _window <= 360
            ? L["History_ResolutionMinute"].Value
            : L["History_ResolutionHour"].Value;
        return $"{window} · {resolution}";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
