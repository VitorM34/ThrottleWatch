@page "/clients"
@inject IMetricsService MetricsService
@implements IDisposable

<PageTitle>@L["Clients_PageTitle"]</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Clients_Title"]</h1>
        <p class="page-subtitle">@L["Clients_Subtitle"]</p>
    </div>
    <div class="page-actions">
        <input type="search"
               class="form-control"
               style="width: 220px;"
               placeholder="@L["Clients_SearchPlaceholder"]"
               @bind="_searchQuery"
               @bind:event="oninput"
               aria-label="@L["Clients_SearchAria"]" />
        <select class="form-control" style="width: 140px;" @bind="_riskFilter" aria-label="@L["Clients_RiskFilterAria"]">
            <option value="">@L["Clients_AllRisks"]</option>
            <option value="Low">@L["Common_RiskLow"]</option>
            <option value="Medium">@L["Common_RiskMedium"]</option>
            <option value="High">@L["Common_RiskHigh"]</option>
            <option value="Critical">@L["Common_RiskCritical"]</option>
        </select>
        <button class="btn btn--secondary btn--sm"
                @onclick="RefreshAsync"
                disabled="@_isLoading"
                aria-label="@L["Clients_RefreshAria"]">
            @L["Common_Refresh"]
        </button>
    </div>
</div>

@if (_hasError)
{
    <ErrorState Title="@L["Clients_ErrorLoad"]" OnRetry="RefreshAsync" />
}
else
{
    <div class="grid grid--4" style="margin-bottom: 24px;">
        <MetricCard Label="@L["Clients_Total"]" Value="@_clients.Count.ToString("N0")" Icon="users" AccentVariant="blue" IsLoading="_isLoading" />
        <MetricCard Label="@L["Clients_BlockedNow"]" Value="@_clients.Count(c => c.IsBlocked).ToString("N0")" Icon="ban" AccentVariant="red" IsLoading="_isLoading" />
        <MetricCard Label="@L["Clients_HighRisk"]" Value="@_clients.Count(c => c.RiskLevel >= ClientRisk.High).ToString("N0")" Icon="alert-triangle" AccentVariant="orange" IsLoading="_isLoading" />
        <MetricCard Label="@L["Clients_ActiveToday"]" Value="@_clients.Count(c => (DateTimeOffset.UtcNow - c.LastSeen).TotalHours < 24).ToString("N0")" Icon="activity" AccentVariant="green" IsLoading="_isLoading" />
    </div>

    <ContentCard Title="@L["Clients_AllTitle"]" Subtitle="@string.Format(L["Clients_CountSubtitle"].Value, FilteredClients.Count())">
        <ClientsTable Clients="FilteredClients.ToList()" IsLoading="_isLoading" />
    </ContentCard>
}

@code {
    private IReadOnlyList<ClientMetrics> _clients = [];
    private string _searchQuery = string.Empty;
    private string _riskFilter = string.Empty;
    private bool _isLoading = true;
    private bool _hasError;
    private CancellationTokenSource _cts = new();

    private IEnumerable<ClientMetrics> FilteredClients
    {
        get
        {
            var q = _clients.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_searchQuery))
                q = q.Where(c => c.IpAddress.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_riskFilter) && Enum.TryParse<ClientRisk>(_riskFilter, out var risk))
                q = q.Where(c => c.RiskLevel == risk);
            return q;
        }
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _hasError = false;
        StateHasChanged();
        try
        {
            _clients = await MetricsService.GetAllClientsAsync(_cts.Token);
            if (_clients is null) { _hasError = true; _clients = []; }
        }
        catch (OperationCanceledException) { }
        catch { _hasError = true; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
