@page "/alerts"
@inject IAlertsService AlertsService
@inject IToastService ToastService
@implements IDisposable

<PageTitle>@L["Alerts_PageTitle"]</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Alerts_Title"]</h1>
        <p class="page-subtitle">@L["Alerts_Subtitle"]</p>
    </div>
    <div class="page-actions">
        <button class="btn btn--secondary btn--sm" @onclick="RefreshAsync" disabled="@_isLoading">
            <Icon Name="refresh-cw" Size="sm" /> @L["Common_Refresh"]
        </button>
        @if (_activeTab == "rules")
        {
            <button class="btn btn--primary btn--sm" @onclick="OpenCreateDialog">
                @L["Alerts_NewRule"]
            </button>
        }
    </div>
</div>

<div class="tabs" role="tablist" aria-label="@L["Alerts_TabsAria"]">
    <button type="button"
            class="tabs__item @(_activeTab == "events" ? "tabs__item--active" : null)"
            role="tab"
            aria-selected="@(_activeTab == "events")"
            @onclick='() => SwitchTab("events")'>
        @L["Alerts_TabEvents"]
    </button>
    <button type="button"
            class="tabs__item @(_activeTab == "rules" ? "tabs__item--active" : null)"
            role="tab"
            aria-selected="@(_activeTab == "rules")"
            @onclick='() => SwitchTab("rules")'>
        @L["Alerts_TabRules"]
    </button>
</div>

@if (_hasError)
{
    <ErrorState Title="@L["Alerts_ErrorLoad"]" OnRetry="RefreshAsync" />
}
else if (_activeTab == "events")
{
    <div class="grid grid--4" style="margin-bottom: 24px;">
        <MetricCard Label="@L["Alerts_MetricTotal"]" Value="@_events.Count.ToString()" AccentVariant="blue" IsLoading="_isLoading" />
        <MetricCard Label="@L["Alerts_MetricActive"]" Value="@_events.Count(a => a.Status == AlertStatus.Active).ToString()" AccentVariant="red" IsLoading="_isLoading" />
        <MetricCard Label="@L["Alerts_MetricCritical"]" Value="@_events.Count(a => a.Severity == AlertSeverity.Critical && a.Status == AlertStatus.Active).ToString()" AccentVariant="orange" IsLoading="_isLoading" />
        <MetricCard Label="@L["Alerts_MetricAcknowledged"]" Value="@_events.Count(a => a.Status == AlertStatus.Acknowledged).ToString()" AccentVariant="green" IsLoading="_isLoading" />
    </div>

    @if (_isLoading)
    {
        <div style="display: flex; flex-direction: column; gap: 12px;">
            @for (int i = 0; i < 4; i++)
            {
                <div class="card">
                    <div class="card__body">
                        <div class="skeleton skeleton--text" style="width: 40%; margin-bottom: 8px;"></div>
                        <div class="skeleton skeleton--text" style="width: 70%;"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_events.Count == 0)
    {
        <EmptyState Icon="bell" Title="@L["Alerts_NoEvents"]" Message="@L["Alerts_NoEventsMessage"]" />
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 12px;">
            @foreach (var alert in _events.OrderByDescending(a => a.CreatedAt))
            {
                <div class="card">
                    <div class="card__body">
                        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px;">
                            <div style="display: flex; align-items: flex-start; gap: 12px; flex: 1; min-width: 0;">
                                <div style="padding: 6px; border-radius: var(--tw-radius-md); background: @GetAlertBg(alert.Severity); flex-shrink: 0; color: @GetAlertColor(alert.Severity);">
                                    <Icon Name="@GetAlertIconName(alert.Severity)" Size="md" />
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap;">
                                        <span style="font-weight: 600; font-size: 0.9375rem;">@alert.Title</span>
                                        <Badge Variant="@GetSeverityVariant(alert.Severity)">@alert.Severity</Badge>
                                        <Badge Variant="@GetStatusVariant(alert.Status)">@alert.Status</Badge>
                                    </div>
                                    <p style="font-size: 0.875rem; color: var(--tw-text-secondary); margin: 0;">@alert.Message</p>
                                </div>
                            </div>
                            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex-shrink: 0;">
                                <span style="font-size: 0.8125rem; color: var(--tw-text-muted); white-space: nowrap;">
                                    @FormatTimeAgo(alert.CreatedAt)
                                </span>
                                @if (alert.Status == AlertStatus.Active)
                                {
                                    <button class="btn btn--secondary btn--sm"
                                            @onclick="() => AcknowledgeAsync(alert.Id)"
                                            disabled="@_isSaving">
                                        @L["Alerts_Acknowledge"]
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @if (_isLoading)
    {
        <div class="card"><div class="card__body"><div class="skeleton skeleton--text" style="width: 60%;"></div></div></div>
    }
    else if (_rules.Count == 0)
    {
        <EmptyState Icon="shield" Title="@L["Alerts_NoRules"]" Message="@L["Alerts_NoRulesMessage"]" />
    }
    else
    {
        <ContentCard Title="@L["Alerts_ConfiguredRules"]" Subtitle="@string.Format(L["Alerts_RulesCount"].Value, _rules.Count)">
            <div class="table-wrap">
                <table class="tw-table">
                    <thead>
                        <tr>
                            <th>@L["Alerts_ColName"]</th>
                            <th>@L["Alerts_ColCondition"]</th>
                            <th>@L["Alerts_ColThreshold"]</th>
                            <th>@L["Alerts_ColSeverity"]</th>
                            <th>@L["Alerts_ColCooldown"]</th>
                            <th>@L["Alerts_ColStatus"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in _rules.OrderBy(r => r.Name))
                        {
                            <tr>
                                <td>
                                    <div style="font-weight: 600;">@rule.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(rule.Description))
                                    {
                                        <div style="font-size: 0.8125rem; color: var(--tw-text-muted);">@rule.Description</div>
                                    }
                                </td>
                                <td><code>@rule.Condition</code></td>
                                <td>@rule.Threshold.ToString("0.##")%</td>
                                <td><Badge Variant="@GetSeverityVariant(rule.Severity)">@rule.Severity</Badge></td>
                                <td>@rule.CooldownMinutes min</td>
                                <td>
                                    <Badge Variant="@(rule.IsEnabled ? "success" : "neutral")">
                                        @(rule.IsEnabled ? L["Alerts_Enabled"] : L["Alerts_Disabled"])
                                    </Badge>
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <button class="btn btn--ghost btn--sm" @onclick="() => OpenEditDialog(rule)">@L["Alerts_Edit"]</button>
                                    <button class="btn btn--ghost btn--sm" @onclick="() => AskDelete(rule)">@L["Alerts_Delete"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </ContentCard>
    }
}

@if (_showFormDialog)
{
    <div class="dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="alert-rule-dialog-title">
        <div class="dialog dialog--lg">
            <div class="dialog__header">
                <h3 id="alert-rule-dialog-title" class="dialog__title">
                    @(_formModel.Id is null ? L["Alerts_NewRule"] : L["Alerts_EditRule"])
                </h3>
                <button class="btn btn--ghost btn--icon btn--sm" @onclick="CloseFormDialog" aria-label="@L["Alerts_Close"]">
                    <Icon Name="x" Size="sm" />
                </button>
            </div>
            <div class="dialog__body">
                <EditForm Model="_formModel" OnValidSubmit="SaveRuleAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />

                    <div class="form-group">
                        <label class="form-label" for="rule-name">@L["Alerts_Name"]</label>
                        <InputText id="rule-name" class="form-control" @bind-Value="_formModel.Name" />
                        <ValidationMessage For="() => _formModel.Name" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="rule-description">@L["Alerts_Description"]</label>
                        <InputTextArea id="rule-description" class="form-control" rows="2" @bind-Value="_formModel.Description" />
                        <ValidationMessage For="() => _formModel.Description" class="validation-message" />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="rule-condition">@L["Alerts_Condition"]</label>
                        <InputSelect id="rule-condition" class="form-control" @bind-Value="_formModel.Condition">
                            <option value="block_rate">block_rate</option>
                        </InputSelect>
                        <ValidationMessage For="() => _formModel.Condition" class="validation-message" />
                        <small style="color: var(--tw-text-muted); font-size: 0.8125rem;">
                            @L["Alerts_ConditionHint"]
                        </small>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label class="form-label" for="rule-threshold">@L["Alerts_ThresholdPercent"]</label>
                            <InputNumber id="rule-threshold" class="form-control" @bind-Value="_formModel.Threshold" />
                            <ValidationMessage For="() => _formModel.Threshold" class="validation-message" />
                        </div>
                        <div class="form-group">
                            <label class="form-label" for="rule-cooldown">@L["Alerts_CooldownMinutes"]</label>
                            <InputNumber id="rule-cooldown" class="form-control" @bind-Value="_formModel.CooldownMinutes" />
                            <ValidationMessage For="() => _formModel.CooldownMinutes" class="validation-message" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group">
                            <label class="form-label" for="rule-severity">@L["Alerts_Severity"]</label>
                            <InputSelect id="rule-severity" class="form-control" @bind-Value="_formModel.Severity">
                                <option value="@AlertSeverity.Info">Info</option>
                                <option value="@AlertSeverity.Warning">Warning</option>
                                <option value="@AlertSeverity.Critical">Critical</option>
                            </InputSelect>
                            <ValidationMessage For="() => _formModel.Severity" class="validation-message" />
                        </div>
                        @if (_formModel.Id is not null)
                        {
                            <div class="form-group">
                                <label class="form-label" for="rule-enabled">@L["Alerts_Enabled"]</label>
                                <div style="display: flex; align-items: center; gap: 8px; min-height: 38px;">
                                    <InputCheckbox id="rule-enabled" @bind-Value="_formModel.IsEnabled" />
                                    <span style="font-size: 0.875rem; color: var(--tw-text-secondary);">
                                        @(_formModel.IsEnabled ? L["Alerts_RuleEnabled"] : L["Alerts_RuleDisabled"])
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="dialog__footer" style="margin: 24px -24px -24px; padding: 16px 24px;">
                        <button type="button" class="btn btn--ghost" @onclick="CloseFormDialog" disabled="@_isSaving">
                            @L["Alerts_Cancel"]
                        </button>
                        <button type="submit" class="btn btn--primary" disabled="@_isSaving">
                            @(_isSaving ? L["Alerts_Saving"] : L["Alerts_Save"])
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsOpen="_showDeleteDialog"
               Title="@L["Alerts_DeleteTitle"]"
               Message="@string.Format(L["Alerts_DeleteMessage"].Value, _rulePendingDelete?.Name)"
               ConfirmLabel="@L["Alerts_Delete"]"
               CancelLabel="@L["Alerts_Cancel"]"
               IsDangerous="true"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDelete" />

@code {
    private string _activeTab = "events";
    private IReadOnlyList<AlertInfo> _events = [];
    private IReadOnlyList<AlertRuleInfo> _rules = [];
    private AlertRuleFormModel _formModel = AlertRuleFormModel.CreateNew();
    private AlertRuleInfo? _rulePendingDelete;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _hasError;
    private bool _showFormDialog;
    private bool _showDeleteDialog;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _hasError = false;
        StateHasChanged();

        try
        {
            if (_activeTab == "events")
            {
                _events = await AlertsService.GetEventsAsync(cancellationToken: _cts.Token);
            }
            else
            {
                _rules = await AlertsService.GetRulesAsync(_cts.Token);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            _hasError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenCreateDialog()
    {
        _formModel = AlertRuleFormModel.CreateNew();
        _showFormDialog = true;
    }

    private void OpenEditDialog(AlertRuleInfo rule)
    {
        _formModel = AlertRuleFormModel.FromRule(rule);
        _showFormDialog = true;
    }

    private void CloseFormDialog()
    {
        if (_isSaving)
            return;

        _showFormDialog = false;
    }

    private async Task SaveRuleAsync()
    {
        _isSaving = true;
        try
        {
            AlertRuleInfo? saved;
            if (_formModel.Id is null)
                saved = await AlertsService.CreateRuleAsync(_formModel, _cts.Token);
            else
                saved = await AlertsService.UpdateRuleAsync(_formModel, _cts.Token);

            if (saved is null)
            {
                ToastService.ShowError(L["Alerts_SaveError"]);
                return;
            }

            ToastService.ShowSuccess(_formModel.Id is null ? L["Alerts_Created"] : L["Alerts_Updated"]);
            _showFormDialog = false;
            await RefreshAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void AskDelete(AlertRuleInfo rule)
    {
        _rulePendingDelete = rule;
        _showDeleteDialog = true;
    }

    private void CancelDelete()
    {
        _showDeleteDialog = false;
        _rulePendingDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_rulePendingDelete is null)
            return;

        var id = _rulePendingDelete.Id;
        _showDeleteDialog = false;
        _rulePendingDelete = null;

        var ok = await AlertsService.DeleteRuleAsync(id, _cts.Token);
        if (!ok)
        {
            ToastService.ShowError(L["Alerts_DeleteError"]);
            return;
        }

        ToastService.ShowSuccess(L["Alerts_Deleted"]);
        await RefreshAsync();
    }

    private async Task AcknowledgeAsync(Guid eventId)
    {
        _isSaving = true;
        try
        {
            var ok = await AlertsService.AcknowledgeEventAsync(eventId, _cts.Token);
            if (!ok)
            {
                ToastService.ShowError(L["Alerts_AckError"]);
                return;
            }

            ToastService.ShowSuccess(L["Alerts_Acknowledged"]);
            await RefreshAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string GetAlertIconName(AlertSeverity s) => s switch
    {
        AlertSeverity.Critical => "x",
        AlertSeverity.Warning => "alert-triangle",
        _ => "info"
    };

    private static string GetAlertColor(AlertSeverity s) => s switch
    {
        AlertSeverity.Critical => "var(--tw-status-error)",
        AlertSeverity.Warning => "var(--tw-status-warning)",
        _ => "var(--tw-color-brand-blue)"
    };

    private static string GetAlertBg(AlertSeverity s) => s switch
    {
        AlertSeverity.Critical => "var(--tw-status-error-bg)",
        AlertSeverity.Warning => "var(--tw-status-warning-bg)",
        _ => "var(--tw-color-brand-blue-bg, rgba(79, 142, 247, 0.12))"
    };

    private static string GetSeverityVariant(AlertSeverity s) => s switch
    {
        AlertSeverity.Critical => "error",
        AlertSeverity.Warning => "warning",
        _ => "info"
    };

    private static string GetStatusVariant(AlertStatus s) => s switch
    {
        AlertStatus.Active => "error",
        AlertStatus.Acknowledged => "warning",
        AlertStatus.Resolved => "success",
        _ => "neutral"
    };

    private string FormatTimeAgo(DateTimeOffset dt)
    {
        var span = DateTimeOffset.UtcNow - dt;
        if (span.TotalMinutes < 1) return L["Time_JustNow"];
        if (span.TotalMinutes < 60) return string.Format(L["Time_MinutesAgo"].Value, (int)span.TotalMinutes);
        if (span.TotalHours < 24) return string.Format(L["Time_HoursAgo"].Value, (int)span.TotalHours);
        return string.Format(L["Time_DaysAgo"].Value, (int)span.TotalDays);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
