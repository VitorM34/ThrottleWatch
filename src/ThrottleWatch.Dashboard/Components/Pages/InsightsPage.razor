@page "/insights"
@inject IInsightsService InsightsService
@inject IToastService ToastService
@implements IDisposable

<PageTitle>@L["Insights_PageTitle"]</PageTitle>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Insights_Title"]</h1>
        <p class="page-subtitle">@L["Insights_Subtitle"]</p>
    </div>
    <div class="page-actions">
        <button class="btn btn--secondary btn--sm" @onclick="RefreshAsync" disabled="@_isLoading">@L["Common_Refresh"]</button>
    </div>
</div>

@if (_hasError)
{
    <ErrorState Title="@L["Insights_ErrorLoad"]" OnRetry="RefreshAsync" />
}
else if (_isLoading)
{
    <div style="display: flex; flex-direction: column; gap: 12px;">
        @for (int i = 0; i < 3; i++)
        {
            <div class="card">
                <div class="card__body" style="display: flex; flex-direction: column; gap: 10px;">
                    <div class="skeleton skeleton--text" style="width: 30%;"></div>
                    <div class="skeleton skeleton--text" style="width: 60%;"></div>
                    <div class="skeleton skeleton--text" style="width: 80%;"></div>
                </div>
            </div>
        }
    </div>
}
else if (_insights.Count == 0)
{
    <EmptyState Icon="lightbulb"
                Title="@L["Insights_EmptyTitle"]"
                Message="@L["Insights_EmptyMessage"]" />
}
else
{
    <div class="grid grid--3" style="margin-bottom: 24px;">
        <MetricCard Label="@L["Insights_Critical"]" Value="@_insights.Count(i => i.Severity == AlertSeverity.Critical).ToString()" AccentVariant="red" IsLoading="_isLoading" />
        <MetricCard Label="@L["Insights_Warnings"]" Value="@_insights.Count(i => i.Severity == AlertSeverity.Warning).ToString()" AccentVariant="orange" IsLoading="_isLoading" />
        <MetricCard Label="@L["Insights_Info"]" Value="@_insights.Count(i => i.Severity == AlertSeverity.Info).ToString()" AccentVariant="blue" IsLoading="_isLoading" />
    </div>

    <div style="display: flex; flex-direction: column; gap: 16px;">
        @foreach (var insight in _insights.OrderByDescending(i => i.Severity).ThenByDescending(i => i.GeneratedAt))
        {
            <div class="card">
                <div class="card__body">
                    <div style="display: flex; align-items: flex-start; gap: 16px;">
                        <div style="width: 44px; height: 44px; border-radius: var(--tw-radius-md); display: flex; align-items: center; justify-content: center; background: @GetInsightBg(insight.Type); flex-shrink: 0; color: var(--tw-text-primary);">
                            <Icon Name="@GetInsightIconName(insight.Type)" Size="lg" />
                        </div>
                        <div style="flex: 1; min-width: 0;">
                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px; flex-wrap: wrap;">
                                <span style="font-weight: 600; font-size: 0.9375rem;">@insight.Title</span>
                                <Badge Variant="@GetSeverityVariant(insight.Severity)">@insight.Severity</Badge>
                                <Badge Variant="neutral">@FormatInsightType(insight.Type)</Badge>
                            </div>
                            <p style="font-size: 0.875rem; color: var(--tw-text-secondary); margin: 0 0 10px;">@insight.Description</p>
                            @if (!string.IsNullOrWhiteSpace(insight.AffectedResource))
                            {
                                <div style="font-size: 0.8125rem; color: var(--tw-text-muted);">
                                    @L["Insights_Resource"] <code>@insight.AffectedResource</code>
                                </div>
                            }
                        </div>
                        <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex-shrink: 0;">
                            <span style="font-size: 0.8125rem; color: var(--tw-text-muted); white-space: nowrap;">
                                @insight.GeneratedAt.ToString("MMM d, HH:mm")
                            </span>
                            <button class="btn btn--secondary btn--sm"
                                    @onclick="() => DismissAsync(insight.Id)"
                                    disabled="@_isSaving">
                                @L["Insights_Dismiss"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<InsightInfo> _insights = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _hasError;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _isLoading = true;
        _hasError = false;
        StateHasChanged();
        try
        {
            _insights = await InsightsService.GetActiveInsightsAsync(_cts.Token);
        }
        catch (OperationCanceledException) { }
        catch { _hasError = true; }
        finally { _isLoading = false; StateHasChanged(); }
    }

    private async Task DismissAsync(Guid id)
    {
        _isSaving = true;
        try
        {
            var ok = await InsightsService.DismissInsightAsync(id, _cts.Token);
            if (!ok)
            {
                ToastService.ShowError(L["Insights_DismissError"]);
                return;
            }

            ToastService.ShowSuccess(L["Insights_Dismissed"]);
            await RefreshAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string GetInsightIconName(InsightType t) => t switch
    {
        InsightType.HighBlockRate => "percent",
        InsightType.SuspiciousClient => "user-x",
        InsightType.MisconfiguredPolicy => "shield",
        InsightType.PeakHours => "zap",
        InsightType.UnusualPattern => "radio",
        _ => "info"
    };

    private static string GetInsightBg(InsightType t) => t switch
    {
        InsightType.HighBlockRate => "var(--tw-status-warning-bg)",
        InsightType.SuspiciousClient => "var(--tw-status-error-bg)",
        InsightType.MisconfiguredPolicy => "var(--tw-status-warning-bg)",
        InsightType.PeakHours => "var(--tw-status-info-bg)",
        _ => "var(--tw-status-info-bg)"
    };

    private static string GetSeverityVariant(AlertSeverity s) => s switch
    {
        AlertSeverity.Critical => "error",
        AlertSeverity.Warning => "warning",
        _ => "info"
    };

    private string FormatInsightType(InsightType t) => t switch
    {
        InsightType.HighBlockRate => L["Insights_TypeHighBlockRate"],
        InsightType.SuspiciousClient => L["Insights_TypeSuspicious"],
        InsightType.MisconfiguredPolicy => L["Insights_TypeMisconfigured"],
        InsightType.PeakHours => L["Insights_TypePeakHours"],
        InsightType.UnusualPattern => L["Insights_TypeUnusual"],
        _ => t.ToString()
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
