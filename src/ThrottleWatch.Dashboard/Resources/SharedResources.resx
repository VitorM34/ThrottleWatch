  <data name="About_WhatTitle" xml:space="preserve"><value>What is ThrottleWatch?</value></data>
  <data name="About_WhatBody" xml:space="preserve"><value>ThrottleWatch is an open-source observability layer for ASP.NET Core Rate Limiting. It provides real-time monitoring, historical analysis, smart alerts, and insights to help you understand how your rate limiting policies perform and how clients interact with your APIs.</value></data>
  <data name="About_Architecture" xml:space="preserve"><value>Architecture</value></data>
  <data name="About_TechStack" xml:space="preserve"><value>Technology Stack</value></data>
  <data name="About_OpenSource" xml:space="preserve"><value>Open Source</value></data>
  <data name="About_OpenSourceBody" xml:space="preserve"><value>ThrottleWatch is distributed under the MIT License. Contributions are welcome!</value></data>
  <data name="About_GitHub" xml:space="preserve"><value>GitHub Repository</value></data>
  <data name="About_Comp_Middleware" xml:space="preserve"><value>ThrottleWatch Middleware</value></data>
  <data name="About_Comp_MiddlewareDesc" xml:space="preserve"><value>Intercepts HTTP requests, records metrics, and evaluates rate limiting policies in O(1)</value></data>
  <data name="About_Comp_Queue" xml:space="preserve"><value>In-Memory Queue</value></data>
  <data name="About_Comp_QueueDesc" xml:space="preserve"><value>Thread-safe buffer via System.Threading.Channels for high-throughput metric collection</value></data>
  <data name="About_Comp_Worker" xml:space="preserve"><value>Background Worker</value></data>
