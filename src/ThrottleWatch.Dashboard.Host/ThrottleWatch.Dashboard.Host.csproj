<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ThrottleWatch.Dashboard.Host</RootNamespace>
    <AssemblyName>ThrottleWatch.Dashboard.Host</AssemblyName>
    <UserSecretsId>throttlewatch-dashboard-dev</UserSecretsId>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThrottleWatch.Dashboard\ThrottleWatch.Dashboard.csproj" />
  </ItemGroup>

</Project>
