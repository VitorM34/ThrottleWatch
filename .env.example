# Local Docker Compose defaults.
# Copy to .env to override:  cp .env.example .env
# .env is gitignored — do not commit secrets.

# PostgreSQL
POSTGRES_DB=throttlewatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Host ports (5080 avoids macOS AirPlay on :5000)
API_PORT=5080
DASHBOARD_PORT=5100
SAMPLE_PORT=5299

# Runtime
ASPNETCORE_ENVIRONMENT=Development
APPLY_MIGRATIONS=true
DASHBOARD_REFRESH_SECONDS=5

# Shared API key (Api + Dashboard + sample Client). Override in real deploys.
THROTTLEWATCH_API_KEY=dev-throttlewatch-key
